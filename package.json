{
  "name": "svelte-app",
  "version": "1.0.0",
  "watch": {
    "build": {
      "patterns": "client",
      "extensions": "svelte"
    }
  },
  "scripts": {
    "build": "rollup -c rollup-pages.config.js",
    "dev": "rollup -c -w rollup-pages.config.js",
    "client": "sirv client/public",
    "watch": "concurrently \"npm-watch build\" \"nodemon --config nodemon.json server/app.js\""
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^14.0.0",
    "@rollup/plugin-node-resolve": "^8.0.0",
    "rollup": "^2.3.4",
    "rollup-plugin-livereload": "^1.0.0",
    "rollup-plugin-multi-input": "^1.1.1",
    "rollup-plugin-svelte": "^5.0.3",
    "rollup-plugin-terser": "^7.0.0",
    "svelte": "^3.0.0"
  },
  "dependencies": {
    "concurrently": "^7.4.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "npm-watch": "^0.11.0",
    "pg": "^8.8.0",
    "sirv-cli": "^1.0.0",
    "socket.io": "^4.8.4"
  }
}
